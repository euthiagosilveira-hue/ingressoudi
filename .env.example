NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=

# URL publica canonica da aplicacao (redirects de Auth, ex.: convite de usuario).
# Producao: https://<seu-projeto>.vercel.app (precisa ser https para o OAuth e o webhook)
# Desenvolvimento: http://localhost:3000
NUXT_PUBLIC_SITE_URL=

# Privadas — somente backend (nunca usar prefixo NUXT_PUBLIC_)
NUXT_SUPABASE_SECRET_KEY=
# Mercado Pago marketplace (OAuth por organizacao)
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
# 32+ caracteres aleatorios. Trocar esta chave invalida as conexoes ja feitas.
MERCADO_PAGO_TOKEN_KEY=
# true somente com credenciais de teste
MERCADO_PAGO_OAUTH_TEST_TOKEN=false
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_TEST_AUTO_APPROVE_PIX=false
